#!/bin/bash
###############################################################################
# Firewall Script : rc.loclal                                                 #
# Beschreibung    : Schützen eines privaten VPS                               #
# OS              : Debian 13 trixie                                          #
###############################################################################

# By default this script does nothing.
#
# Do make it works ....
# create /etc/rc.local
# chmod +x rc.local
# systemctl daemon-reload
# systemctl start rc-local
# systemctl status rc-local


if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root"
   exit 1
fi

if [ -f /etc/config/cfg/disable_ipv6 ]; then
   /sbin/sysctl -w net.ipv6.conf.all.disable_ipv6=1 > /dev/null 2>&1
   /sbin/sysctl -w net.ipv6.conf.all.autoconf=0 > /dev/null 2>&1
   /sbin/sysctl -w net.ipv6.conf.default.disable_ipv6=1 > /dev/null 2>&1
fi

dmesg -n 1

# exit 0

#if [ -f /etc/rc.local2 ]; then
#   cd /etc
#   ./rc.local2
#fi

if [ -f /etc/config/cfg/optimize_virtual_server_01 ]; then

   # ===================================================================
   # OpenStack Performance Tuning – 1 vCPU, 1 GB RAM
   # Debian 13 - Optimiert für Single-Core mit minimalem RAM
   # ===================================================================
   #
   # DIESES SKRIPT OPTIMIERT EINE OPENSTACK VM MIT:
   # - 1 vCPU (keine Parallelität, nur Task-Switching)
   # - 1 GB RAM (sehr begrenzt, daher aggressive Optimierungen)
   # - OpenStack/KVM Hypervisor
   #
   # ZIEL: Maximale Performance trotz extrem limitierter Ressourcen
   # FOKUS: Swapping vermeiden, CPU-Kontextwechsel minimieren
   # ===================================================================

   echo "[INFO] Starte OpenStack 1 vCPU / 1 GB RAM Optimierung..."

   # ===================================================================
   # 1. SICHERE SYSCTL-FUNKTION
   # ===================================================================
   safe_sysctl() {
   local param="$1"
   local value="$2"
   local sysctl_path="/proc/sys/${param//./\/}"

   if [ -f "$sysctl_path" ] && [ -w "$sysctl_path" ]; then
        if sysctl -w "$param=$value" > /dev/null 2>&1; then
            echo "[OK]   $param = $value"
            return 0
        fi
   fi
    echo "[SKIP] $param nicht verfügbar"
    return 1
   }

   # ===================================================================
   # 2. SPEICHER-OPTIMIERUNGEN (KRITISCH BEI 1 GB RAM!)
   # ===================================================================
   echo "[INFO] Setze SPEICHERkritische Optimierungen für 1 GB RAM..."

   # vm.swappiness: EXTREM NIEDRIG um Swapping zu vermeiden
   # Wert 1: Kernel tausst fast nie aus - bei 1 GB RAM ist Swapping tödlich für Performance
   # Swapping verursacht bei Single-CPU massive Einbrüche (10-100x langsamer)
   safe_sysctl vm.swappiness 1

   # vm.vfs_cache_pressure: Erhöht, um RAM für Anwendungen freizugeben
   # Wert 100: Aggressivere Bereinigung von Inode/Dentry Caches
   # Bei 1 GB RAM muss Cache-RAM für Anwendungen priorisiert werden
   safe_sysctl vm.vfs_cache_pressure 100

   # vm.dirty_background_ratio: SEHR NIEDRIG für häufiges Writeback
   # Wert 1%: Schreibvorgänge starten bei nur 10MB RAM-Verbrauch
   # Verhindert, dass zu viele "dirty pages" RAM blockieren
   safe_sysctl vm.dirty_background_ratio 1

   # vm.dirty_ratio: NIEDRIG um Prozess-Blockierung zu vermeiden
   # Wert 5%: Prozesse blockieren bei 50MB RAM-Verbrauch
   # Bei Single-CPU: Blockierte Prozesse = gesamtes System blockiert
   safe_sysctl vm.dirty_ratio 5

   # vm.dirty_expire_centisecs: KURZ für schnelles Writeback
   # 1000 = 10 Sekunden: Dirty pages müssen schnell geschrieben werden
   # RAM ist knapp - kann nicht lange für Schreiboperationen blockiert bleiben
   safe_sysctl vm.dirty_expire_centisecs 1000

   # vm.dirty_writeback_centisecs: HÄUFIG für konstante Writebacks
   # 100 = 1 Sekunde: Sehr häufige Prüfungen für gleichmäßige I/O-Last
   # Verhindert I/O-Spitzen, die bei Single-CPU besonders problematisch sind
   safe_sysctl vm.dirty_writeback_centisecs 100

   # ===================================================================
   # 3. OVERCOMMIT EINSTELLUNGEN (WICHTIG FÜR 1 GB RAM)
   # ===================================================================
   echo "[INFO] Setze Memory-Overcommit für limitierten RAM..."

   # vm.overcommit_memory: AGRESSIVES Overcommiting
   # Wert 1: Immer overcommitten - notwendig für kleine RAM-Systeme
   # Erlaubt mehr Prozesse als physikalisch möglich, riskant aber notwendig
   safe_sysctl vm.overcommit_memory 1

   # vm.overcommit_ratio: Prozent des RAMs der overcommitted werden kann
   # Wert 95: Fast das gesamte RAM kann overcommitted werden
   safe_sysctl vm.overcommit_ratio 95

   # ===================================================================
   # 4. NETZWERK-OPTIMIERUNGEN (SINGLE-CPU OPTIMIERT)
   # ===================================================================
   echo "[INFO] Setze NETZWERKoptimierungen für Single-CPU..."

   # net.core.netdev_max_backlog: KLEINER WERT für weniger Kontextwechsel
   # 1024: Kleine Queue, um CPU nicht mit Paketverarbeitung zu überlasten
   # Single-CPU kann nicht viele Pakete parallel verarbeiten
   safe_sysctl net.core.netdev_max_backlog 1024

   # net.core.netdev_budget: WENIGER Pakete pro Polling-Zyklus
   # 150: Konservativ, um CPU-Zeit für Anwendungen zu erhalten
   safe_sysctl net.core.netdev_budget 150

   # net.core.netdev_budget_usecs: KURZE Polling-Zeit
   # 2000µs = 2ms: Begrenzt CPU-Zeit für Netzwerkverarbeitung
   safe_sysctl net.core.netdev_budget_usecs 2000

   # net.ipv4.tcp_fin_timeout: SCHNELLER Verbindungsabbau
   # 10 Sekunden: Reduziert TIME-WAIT Zustände die RAM belegen
   safe_sysctl net.ipv4.tcp_fin_timeout 10

   # net.ipv4.tcp_tw_reuse: AKTIVIERT für Socket-Wiederverwendung
   # Wichtig bei begrenztem RAM für neue Verbindungen
   safe_sysctl net.ipv4.tcp_tw_reuse 1

   # net.ipv4.tcp_slow_start_after_idle: DEAKTIVIERT
   # Wert 0: TCP bleibt auf voller Geschwindigkeit auch nach Pausen
   safe_sysctl net.ipv4.tcp_slow_start_after_idle 0

   # TCP Keepalive: KÜRZERE Intervalle für schnelle Verbindungsbereinigung
   safe_sysctl net.ipv4.tcp_keepalive_time 180     # 3 Minuten bis erste Probe
   safe_sysctl net.ipv4.tcp_keepalive_intvl 15     # 15 Sekunden zwischen Proben
   safe_sysctl net.ipv4.tcp_keepalive_probes 3     # Nur 3 Proben

   # TCP Buffer: KLEINERE Werte für weniger RAM-Verbrauch
   safe_sysctl net.core.rmem_default 65536        # 64KB Default Receive Buffer
   safe_sysctl net.core.wmem_default 65536        # 64KB Default Send Buffer
   safe_sysctl net.core.rmem_max 1048576          # Max 1MB Receive Buffer
   safe_sysctl net.core.wmem_max 1048576          # Max 1MB Send Buffer

   # ===================================================================
   # 5. SCHEDULER-OPTIMIERUNGEN (SINGLE-CPU SPEZIFISCH)
   # ===================================================================
   echo "[INFO] Setze SCHEDULERoptimierungen für Single-CPU..."

   # kernel.sched_autogroup_enabled: DEAKTIVIERT für weniger Overhead
   # Bei Single-CPU bringt Autogroup keine Vorteile, nur Overhead
   [ -f /proc/sys/kernel/sched_autogroup_enabled ] && safe_sysctl kernel.sched_autogroup_enabled 0

   # kernel.sched_migration_cost_ns: ERHÖHT für weniger Task-Migration
   # 10000000 = 10ms: Tasks bleiben länger auf derselben CPU (sinnvoll bei nur 1 CPU)
   [ -f /proc/sys/kernel/sched_migration_cost_ns ] && safe_sysctl kernel.sched_migration_cost_ns 10000000

   # ===================================================================
   # 6. DATEISYSTEM-OPTIMIERUNGEN (MINIMALER RAM)
   # ===================================================================
   echo "[INFO] Setze DATEISYSTEMoptimierungen für 1 GB RAM..."

   # fs.file-max: WENIGER Dateihandles für weniger Kernel-Overhead
   # 65536: Ausreichend für kleine Systeme, spart RAM im Kernel
   safe_sysctl fs.file-max 65536

   # fs.nr_open: Proportional zu file-max
   safe_sysctl fs.nr_open 32768

   # ===================================================================
   # 7. IRQ-HANDLING (ALLES AUF CPU0)
   # ===================================================================
   echo "[INFO] Konfiguriere IRQ-Handling für Single-CPU..."

   # IRQ Balance DEAKTIVIEREN - bei Single-CPU unnötig
   if command -v systemctl >/dev/null 2>&1 && systemctl is-active irqbalance >/dev/null 2>&1; then
      echo "[INFO] Deaktiviere irqbalance (Single-CPU)..."
      systemctl stop irqbalance
      systemctl disable irqbalance
  fi

  # IRQ Affinity manuell auf CPU0 setzen
  if [ -d /proc/irq ]; then
     echo "[INFO] Setze alle IRQs auf CPU0..."
     # Verwende find für sichere Dateisuche
     find /proc/irq -name "smp_affinity" -type f 2>/dev/null | while read -r irq; do
          if [ -w "$irq" ]; then
            echo 1 > "$irq" 2>/dev/null && echo "[OK] Setze IRQ Affinity: $irq" || true
          fi
    done
  fi

  # ===================================================================
  # 8. CPU-FREQUENZ GOVERNOR (PERFORMANCE)
  # ===================================================================
  echo "[INFO] Setze CPU-Governor auf Performance..."

  if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
     echo performance > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
     echo "[OK] CPU0 auf Performance-Governor gesetzt"
  fi

  # ===================================================================
  # 9. OOM-KILLER KONFIGURATION (KRITISCH BEI 1 GB RAM!)
  # ===================================================================
  echo "[INFO] Konfiguriere OOM-Killer für limitierten RAM..."

  # vm.panic_on_oom: KEIN Panic bei OOM - System soll weiterlaufen
  safe_sysctl vm.panic_on_oom 0

  # vm.oom_kill_allocating_task: Priorisiere aktuellen Task
  # Wert 1: Beende den Task, der gerade RAM anfordert - schnellere Reaktion
  safe_sysctl vm.oom_kill_allocating_task 1

  # ===================================================================
  # 10. PERSISTENTE KONFIGURATION
  # ===================================================================
  echo "[INFO] Erstelle persistente Konfiguration..."
  CONFIG_FILE="/etc/sysctl.d/90-openstack-1cpu-1gb.conf"

  # Backup
  if [ -f "$CONFIG_FILE" ]; then
     BACKUP_FILE="${CONFIG_FILE}.backup.$(date +%Y%m%d_%H%M%S)"
     cp "$CONFIG_FILE" "$BACKUP_FILE"
     echo "[INFO] Backup erstellt: $BACKUP_FILE"
  fi

  # Konfiguration erstellen
  cat > "$CONFIG_FILE" << 'EOF'
  # ===================================================================
  # OpenStack Performance Tuning – 1 vCPU, 1 GB RAM
  # Debian 13 - Generiert: $(date)
  # ===================================================================

  # SPEICHER-OPTIMIERUNGEN (KRITISCH FÜR 1 GB RAM)
  vm.swappiness = 1                    # Minimiert Swapping
  vm.vfs_cache_pressure = 100          # Aggressive Cache-Bereinigung
  vm.dirty_background_ratio = 1        # Frühes Writeback (bei 10MB)
  vm.dirty_ratio = 5                   # Prozess-Blockierung bei 50MB
  vm.dirty_expire_centisecs = 1000     # 10 Sekunden bis Writeback
  vm.dirty_writeback_centisecs = 100   # Alle 1 Sekunde prüfen

  # OVERCOMMIT FÜR KLEINES RAM
  vm.overcommit_memory = 1             # Aggressives Overcommitting
  vm.overcommit_ratio = 95             # 95% des RAMs overcommitbar

  # NETZWERK-OPTIMIERUNGEN (SINGLE-CPU)
  net.core.netdev_max_backlog = 1024   # Kleine Queue für Single-CPU
  net.core.netdev_budget = 150         # Wenige Pakete pro Zyklus
  net.core.netdev_budget_usecs = 2000  # Nur 2ms pro Polling
  net.ipv4.tcp_fin_timeout = 10        # Schneller Verbindungsabbau
  net.ipv4.tcp_tw_reuse = 1            # Socket-Wiederverwendung
  net.ipv4.tcp_slow_start_after_idle = 0 # Kein Slow-Start

  # TCP KEEPALIVE (KURZE INTERVALLLE)
  net.ipv4.tcp_keepalive_time = 180
  net.ipv4.tcp_keepalive_intvl = 15
  net.ipv4.tcp_keepalive_probes = 3

  # TCP BUFFER (KLEIN FÜR WENIG RAM)
  net.core.rmem_default = 65536
  net.core.wmem_default = 65536
  net.core.rmem_max = 1048576
  net.core.wmem_max = 1048576

  # SCHEDULER (SINGLE-CPU OPTIMIERT)
  kernel.sched_autogroup_enabled = 0

  # DATEISYSTEM (MINIMAL)
  fs.file-max = 65536
  fs.nr_open = 32768

  # OOM-KILLER
  vm.panic_on_oom = 0
  vm.oom_kill_allocating_task = 1
EOF

  # Konfiguration laden
  sysctl -p "$CONFIG_FILE" 2>/dev/null || true
  echo "[OK] Konfiguration geladen: $CONFIG_FILE"

  # ===================================================================
  # 11. VERIFIZIERUNG
  # ===================================================================
  echo "[INFO] Verifiziere kritische Einstellungen..."
  echo "================================================================"
  echo "SPEICHERKONFIGURATION (1 GB RAM):"
  echo "Swappiness: $(cat /proc/sys/vm/swappiness 2>/dev/null || echo 'N/A')"
  echo "Dirty Ratio: $(cat /proc/sys/vm/dirty_ratio 2>/dev/null || echo 'N/A')"
  echo "Overcommit: $(cat /proc/sys/vm/overcommit_memory 2>/dev/null || echo 'N/A')"
  echo ""
  echo "NETZWERKKONFIGURATION:"
  echo "Backlog: $(cat /proc/sys/net/core/netdev_max_backlog 2>/dev/null || echo 'N/A')"
  echo "TCP Fin Timeout: $(cat /proc/sys/net/ipv4/tcp_fin_timeout 2>/dev/null || echo 'N/A')"
  echo ""
  echo "SYSTEMSTATUS:"
  echo "Verfügbarer RAM: $(free -m | awk '/^Mem:/ {print $4" MB frei"}')"
  echo "Swap Nutzung: $(free -m | awk '/^Swap:/ {print $3" MB belegt"}')"

  # ===================================================================
  # 12. EMPFEHLUNGEN FÜR 1 vCPU / 1 GB RAM
  # ===================================================================
  echo "================================================================"
  echo "[ERFOLG] Optimierung für 1 vCPU / 1 GB RAM abgeschlossen!"
  echo ""
  echo "KRITISCHE EMPFEHLUNGEN FÜR DIESE KONFIGURATION:"
  echo "1. ANWENDUNGSLIMITS SETZEN:"
  echo "   • Max. RAM pro Prozess: 256-512 MB"
  echo "   • Max. gleichzeitige Verbindungen: 100-200"
  echo "   • Worker-Processes/Threads: 1-2"
  echo ""
  echo "2. MONITORING (regelmäßig prüfen):"
  echo "   • RAM: free -h (verfügbaren RAM überwachen)"
  echo "   • Swap: swapon -s (Swap-Nutzung vermeiden)"
  echo "   • OOM Events: dmesg | grep -i oom"
  echo ""
  echo "3. WICHTIGSTE PARAMETER FÜR ANWENDUNGEN:"
  echo "   • MySQL/PostgreSQL: shared_buffers = 128M"
  echo "   • Java: -Xmx256m -Xms128m"
  echo "   • PHP-FPM: pm.max_children = 5-10"
  echo ""
  echo "Konfiguration: $CONFIG_FILE"
  echo "Zurücksetzen: rm $CONFIG_FILE && sysctl --system"
  echo "================================================================"
fi

if [ -f /etc/config/cfg/optimize_virtual_server_02 ]; then

   # ===================================================================
   # OpenStack Performance Tuning – 2 vCPUs, 4 GB RAM
   # Debian 13 - Optimiert für Dual-Core mit moderatem RAM
   # ===================================================================
   #
   # DIESES SKRIPT OPTIMIERT EINE OPENSTACK VM MIT:
   # - 2 vCPUs (echte Parallelität möglich)
   # - 4 GB RAM (ausreichend für die meisten Anwendungen)
   # - OpenStack/KVM Hypervisor
   #
   # ZIEL: Maximale Parallelverarbeitung und Speichernutzung
   # FOKUS: CPU-Lastverteilung, RAM-Caching, Netzwerk-Durchsatz
   # ===================================================================

   echo "[INFO] Starte OpenStack 2 vCPUs / 4 GB RAM Optimierung..."

   # ===================================================================
   # 1. SICHERE SYSCTL-FUNKTION
   # ===================================================================
   safe_sysctl() {
        local param="$1"
        local value="$2"
        local sysctl_path="/proc/sys/${param//./\/}"

   if [ -f "$sysctl_path" ] && [ -w "$sysctl_path" ]; then
        if sysctl -w "$param=$value" > /dev/null 2>&1; then
            echo "[OK]   $param = $value"
            return 0
        fi
   fi
   echo "[SKIP] $param nicht verfügbar"
   return 1
   }

   # ===================================================================
   # 2. SPEICHER-OPTIMIERUNGEN (4 GB RAM OPTIMAL NUTZEN)
   # ===================================================================
   echo "[INFO] Setze SPEICHERoptimierungen für 4 GB RAM..."

   # vm.swappiness: AUSGEWOGEN für optimale Performance
   # Wert 10: Minimales Swapping, aber nicht komplett deaktiviert
   # Bei 4 GB RAM ist gelegentliches Swapping akzeptabel
   safe_sysctl vm.swappiness 10

   # vm.vfs_cache_pressure: AUSGEWOGEN für gute Cache-Performance
   # Wert 50: Standard - ausgewogenes Verhältnis von Cache zu freiem RAM
   safe_sysctl vm.vfs_cache_pressure 50

   # vm.dirty_background_ratio: MODERAT für Hintergrund-Writeback
   # Wert 5%: Writeback startet bei 200MB - gute Balance für 4 GB System
   safe_sysctl vm.dirty_background_ratio 5

   # vm.dirty_ratio: AUSGEWOGEN für Anwendungsperformance
   # Wert 15%: Prozesse blockieren bei 600MB - gute Responsiveness
   safe_sysctl vm.dirty_ratio 15

   # vm.dirty_expire_centisecs: OPTIMALE Writeback-Zeit
   # 3000 = 30 Sekunden: Dirty pages können länger im RAM bleiben
   safe_sysctl vm.dirty_expire_centisecs 3000

   # vm.dirty_writeback_centisecs: OPTIMALES Prüfintervall
   # 500 = 5 Sekunden: Regelmäßige Prüfungen ohne Overhead
   safe_sysctl vm.dirty_writeback_centisecs 500

   # ===================================================================
   # 3. TRANSPARENT HUGE PAGES (THP) FÜR BESSERE PERFORMANCE
   # ===================================================================
   echo "[INFO] Aktiviere Transparent Huge Pages..."

   if [ -f /sys/kernel/mm/transparent_hugepage/enabled ]; then
      echo "madvise" > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
      echo "[OK] THP auf 'madvise' gesetzt (Anwendungen kontrollieren)"
   fi

   # ===================================================================
   # 4. NETZWERK-OPTIMIERUNGEN (DUAL-CORE OPTIMIERT)
   # ===================================================================
   echo "[INFO] Setze NETZWERKoptimierungen für 2 vCPUs..."

   # net.core.netdev_max_backlog: GRÖSSERE Queue für parallele Verarbeitung
   # 4096: Zwei CPUs können mehr Pakete parallel verarbeiten
   safe_sysctl net.core.netdev_max_backlog 4096

   # net.core.netdev_budget: MEHR Pakete pro Polling-Zyklus
   # 600: Zwei CPUs können mehr Arbeit pro Interrupt erledigen
   safe_sysctl net.core.netdev_budget 600

   # net.core.netdev_budget_usecs: MEHR Zeit für Paketverarbeitung
   # 12000µs = 12ms: Längere Polling-Zeiten für bessere Effizienz
   safe_sysctl net.core.netdev_budget_usecs 12000

   # net.ipv4.tcp_fin_timeout: OPTIMAL für Server-Workloads
   # 20 Sekunden: Ausgewogener Wert für Verbindungsabbau
   safe_sysctl net.ipv4.tcp_fin_timeout 20

   # net.ipv4.tcp_tw_reuse: AKTIVIERT für hohe Verbindungsraten
   # Wichtig für Web-Server und Load Balancer
   safe_sysctl net.ipv4.tcp_tw_reuse 1

   # net.ipv4.tcp_slow_start_after_idle: DEAKTIVIERT
   # Wert 0: Verhindert Performance-Einbrüche nach Inaktivität
   safe_sysctl net.ipv4.tcp_slow_start_after_idle 0

   # net.ipv4.tcp_rmem/tcp_wmem: GRÖSSERE Buffer für besseren Durchsatz
   # 4 GB RAM erlaubt größere TCP Windows für bessere Performance
   safe_sysctl net.ipv4.tcp_rmem "4096 87380 6291456"   # Bis zu 6MB pro Socket
   safe_sysctl net.ipv4.tcp_wmem "4096 16384 4194304"   # Bis zu 4MB pro Socket
   safe_sysctl net.core.rmem_max 6291456                # 6MB Max Receive
   safe_sysctl net.core.wmem_max 4194304                # 4MB Max Send

   # net.ipv4.tcp_congestion_control: MODERNER Algorithmus
   safe_sysctl net.ipv4.tcp_congestion_control cubic

   # TCP Keepalive: STANDARDWERTE für stabile Verbindungen
   safe_sysctl net.ipv4.tcp_keepalive_time 300     # 5 Minuten
   safe_sysctl net.ipv4.tcp_keepalive_intvl 75     # 75 Sekunden
   safe_sysctl net.ipv4.tcp_keepalive_probes 9     # 9 Proben

   # ===================================================================
   # 5. SCHEDULER-OPTIMIERUNGEN (MULTI-CORE OPTIMIERT)
   # ===================================================================
   echo "[INFO] Setze SCHEDULERoptimierungen für 2 vCPUs..."

   # kernel.sched_autogroup_enabled: AKTIVIERT für bessere Desktop/Server-Performance
   # Bei 2 CPUs kann Autogroup Vorteile bei interaktiven Workloads bieten
   [ -f /proc/sys/kernel/sched_autogroup_enabled ] && safe_sysctl kernel.sched_autogroup_enabled 1

   # kernel.sched_migration_cost_ns: NIEDRIGER für bessere Lastverteilung
   # 500000 = 0.5ms: Tasks können schneller zwischen CPUs migrieren
   [ -f /proc/sys/kernel/sched_migration_cost_ns ] && safe_sysctl kernel.sched_migration_cost_ns 500000

   # kernel.sched_min_granularity_ns: OPTIMAL FÜR SERVER
   # 4000000 = 4ms: Größere Zeitscheiben für bessere Cache-Nutzung
   [ -f /proc/sys/kernel/sched_min_granularity_ns ] && safe_sysctl kernel.sched_min_granularity_ns 4000000

   # ===================================================================
   # 6. DATEISYSTEM-OPTIMIERUNGEN (4 GB RAM)
   # ===================================================================
   echo "[INFO] Setze DATEISYSTEMoptimierungen für 4 GB RAM..."

   # fs.file-max: AUSREICHEND für Server-Workloads
   # 2097152 = 2M Dateihandles - gut für Web/DB Server
   safe_sysctl fs.file-max 2097152

   # fs.nr_open: Proportional zu file-max
   safe_sysctl fs.nr_open 1048576

   # ===================================================================
   # 7. IRQ-HANDLING & BALANCING (KRITISCH FÜR 2 CPUs!)
   # ===================================================================
   echo "[INFO] Konfiguriere IRQ-Handling für 2 vCPUs..."

   # IRQ Balance AKTIVIEREN und optimieren

   if command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active irqbalance >/dev/null 2>&1; then
        echo "[INFO] IRQ Balance ist aktiv - optimiere Konfiguration..."
        # Optimierte IRQ Balance Einstellungen
        IRQ_CONF="/etc/default/irqbalance"
        if [ -f "$IRQ_CONF" ]; then
            sed -i 's/^#\?IRQBALANCE_ARGS=.*/IRQBALANCE_ARGS="--powerthresh=75 --idlethresh=85"/' "$IRQ_CONF" 2>/dev/null || true
            systemctl restart irqbalance 2>/dev/null || true
        fi
    else
        echo "[INFO] Aktiviere IRQ Balance für optimale Interrupt-Verteilung..."
        systemctl enable --now irqbalance 2>/dev/null || true
    fi
   fi

   # IRQ Affinity manuell für Netzwerk-Interrupts setzen (SICHERE VERSION)

   if [ -d /proc/irq ]; then
    echo "[INFO] Verteile Netzwerk-IRQs auf beide CPUs..."

    # Finde physische Netzwerk-Interfaces

    for iface in $(ls /sys/class/net/ 2>/dev/null | grep -v lo); do
        IRQ_NUM_FILE="/sys/class/net/${iface}/device/irq"
        if [ -f "$IRQ_NUM_FILE" ]; then
            IRQ_NUM=$(cat "$IRQ_NUM_FILE" 2>/dev/null)
            if [ -n "$IRQ_NUM" ] && [ "$IRQ_NUM" -gt 0 ] 2>/dev/null; then
                IRQ_FILE="/proc/irq/${IRQ_NUM}/smp_affinity"
                if [ -f "$IRQ_FILE" ] && [ -w "$IRQ_FILE" ]; then
                    # Setze IRQ auf beide CPUs (Bitmask 3 = CPU0+CPU1)
                    echo 3 > "$IRQ_FILE" 2>/dev/null && \
                    echo "[OK] IRQ ${IRQ_NUM} für ${iface} auf beide CPUs verteilt" || true
                fi
            fi
        fi
    done
   fi

   # ===================================================================
   # 8. CPU-FREQUENZ & GOVERNOR (PERFORMANCE MODUS)
   # ===================================================================
   echo "[INFO] Setze CPU-Governor für maximale Performance..."

   if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        if [ -f "$cpu" ]; then
            echo performance > "$cpu" 2>/dev/null || true
        fi
    done
    echo "[OK] Alle CPUs auf Performance-Governor gesetzt"
   fi

   # CPU Frequency Scaling optimieren

   if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq ]; then
    MAX_FREQ=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null)
    if [ -n "$MAX_FREQ" ]; then
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
            if [ -f "$cpu" ]; then
                echo "$MAX_FREQ" > "$cpu" 2>/dev/null || true
            fi
        done
    fi
   fi

   # ===================================================================
   # 9. NUMA-OPTIMIERUNGEN (WICHTIG FÜR PERFORMANCE)
   # ===================================================================
   echo "[INFO] Konfiguriere NUMA-Optimierungen..."

   # kernel.numa_balancing: DEAKTIVIERT für bessere Vorhersagbarkeit
   # In VMs mit 2 CPUs meist besser deaktiviert
   [ -f /proc/sys/kernel/numa_balancing ] && safe_sysctl kernel.numa_balancing 0

   # Memory Interleave Policy setzen
   if command -v numactl >/dev/null 2>&1; then
      numactl --interleave=all echo "[INFO] NUMA Interleave aktiviert" >/dev/null 2>&1 || true
   fi

   # ===================================================================
   # 10. VIRTIO-OPTIMIERUNGEN (OPENSTACK/KVM SPEZIFISCH)
   # ===================================================================
   echo "[INFO] Setze VirtIO-Optimierungen..."

   # VirtIO Netzwerk-Optimierungen
   safe_sysctl net.core.optmem_max 20480        # Optimiert für virtuelle Netzwerke
   safe_sysctl net.ipv4.tcp_low_latency 1       # Reduzierte Latenz

   # I/O Scheduler für virtuelle Block Devices - KORRIGIERTE VERSION
   # Verwende shopt nullglob um leere Wildcards zu vermeiden

   shopt -s nullglob 2>/dev/null
   BLOCK_DEVICES=()
   for pattern in "/sys/block/vd*" "/sys/block/nvme*"; do
    for block in $pattern; do
        if [ -d "$block" ]; then
            BLOCK_DEVICES+=("$block")
        fi
    done
   done
   shopt -u nullglob 2>/dev/null

   for block in "${BLOCK_DEVICES[@]}"; do
    dev=$(basename "$block")
    SCHED_PATH="/sys/block/${dev}/queue/scheduler"
    if [ -f "$SCHED_PATH" ]; then
        # Für virtuelle Devices: deadline für beste Performance
        if grep -q "deadline" "$SCHED_PATH" 2>/dev/null; then
            echo deadline > "$SCHED_PATH" 2>/dev/null && \
            echo "[OK] I/O Scheduler für ${dev} auf 'deadline' gesetzt"
        fi

        # Queue-Tiefe optimieren
        echo 256 > "/sys/block/${dev}/queue/nr_requests" 2>/dev/null || true
        echo 512 > "/sys/block/${dev}/queue/read_ahead_kb" 2>/dev/null || true
    fi
   done

   # ===================================================================
   # 11. PERSISTENTE KONFIGURATION
   # ===================================================================
   echo "[INFO] Erstelle persistente Konfiguration..."
   CONFIG_FILE="/etc/sysctl.d/91-openstack-2cpu-4gb.conf"

   # Backup
   if [ -f "$CONFIG_FILE" ]; then
      BACKUP_FILE="${CONFIG_FILE}.backup.$(date +%Y%m%d_%H%M%S)"
      cp "$CONFIG_FILE" "$BACKUP_FILE"
      echo "[INFO] Backup erstellt: ${BACKUP_FILE}"
   fi

   # Konfiguration erstellen
   cat > "$CONFIG_FILE" << 'EOF'
   # ===================================================================
   # OpenStack Performance Tuning – 2 vCPUs, 4 GB RAM
   # Debian 13 - Generiert: $(date)
   # ===================================================================

   # SPEICHER-OPTIMIERUNGEN
   vm.swappiness = 10
   vm.vfs_cache_pressure = 50
   vm.dirty_background_ratio = 5
   vm.dirty_ratio = 15
   vm.dirty_expire_centisecs = 3000
   vm.dirty_writeback_centisecs = 500

   # NETZWERK-OPTIMIERUNGEN
   net.core.netdev_max_backlog = 4096
   net.core.netdev_budget = 600
   net.core.netdev_budget_usecs = 12000
   net.ipv4.tcp_fin_timeout = 20
   net.ipv4.tcp_tw_reuse = 1
   net.ipv4.tcp_slow_start_after_idle = 0
   net.ipv4.tcp_keepalive_time = 300
   net.ipv4.tcp_keepalive_intvl = 75
   net.ipv4.tcp_keepalive_probes = 9

   # TCP BUFFER FÜR 4 GB RAM
   net.ipv4.tcp_rmem = 4096 87380 6291456
   net.ipv4.tcp_wmem = 4096 16384 4194304
   net.core.rmem_max = 6291456
   net.core.wmem_max = 4194304
   net.ipv4.tcp_congestion_control = cubic
   net.core.optmem_max = 20480
   net.ipv4.tcp_low_latency = 1

   # SCHEDULER-OPTIMIERUNGEN
   kernel.sched_autogroup_enabled = 1
   kernel.sched_migration_cost_ns = 500000
   kernel.sched_min_granularity_ns = 4000000

   # DATEISYSTEM-OPTIMIERUNGEN
   fs.file-max = 2097152
   fs.nr_open = 1048576

   # NUMA-OPTIMIERUNGEN
   kernel.numa_balancing = 0
EOF

   # Konfiguration laden
   sysctl -p "$CONFIG_FILE" 2>/dev/null || true
   echo "[OK] Konfiguration geladen: ${CONFIG_FILE}"

   # ===================================================================
   # 12. VERIFIZIERUNG & EMPFEHLUNGEN
   # ===================================================================

   echo "[INFO] Verifiziere Systemkonfiguration..."
   echo "================================================================"
   echo "SYSTEMÜBERSICHT:"
   echo "vCPUs: $(nproc)"
   echo "RAM gesamt: $(free -h | awk '/^Mem:/ {print $2}')"
   echo "RAM frei: $(free -h | awk '/^Mem:/ {print $4}')"
   echo ""
   echo "CPU-STATUS:"
   if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
      echo "CPU0 Governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'N/A')"
      if [ -f /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor ]; then
         echo "CPU1 Governor: $(cat /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor 2>/dev/null || echo 'N/A')"
      fi
   fi
   echo ""
   echo "IRQ-VERTEILUNG:"
   if [ -f /proc/interrupts ]; then
      echo "Aktive IRQs pro CPU (erste 10):"
      grep -E "CPU0|CPU1" /proc/interrupts | head -10 2>/dev/null || echo "Keine IRQ-Information verfügbar"
   fi
   echo ""
   echo "NETZWERKSTATUS:"
   echo "Aktive Verbindungen: $(ss -tun 2>/dev/null | wc -l)"
   echo ""

   # ===================================================================
   # 13. WORKLOAD-SPEZIFISCHE EMPFEHLUNGEN
   # ===================================================================
   echo "================================================================"
   echo "[ERFOLG] Optimierung für 2 vCPUs / 4 GB RAM abgeschlossen!"
   echo ""
   echo "OPTIMALE WORKLOAD-KONFIGURATIONEN:"
   echo ""
   echo "1. WEB-SERVER (nginx/apache):"
   echo "   • Worker Processes: 4-8 (2x vCPUs)"
   echo "   • Worker Connections: 1024-2048"
   echo "   • Keepalive Timeout: 65s"
   echo ""
   echo "2. DATENBANK (MySQL/PostgreSQL):"
   echo "   • shared_buffers: 1GB (25% vom RAM)"
   echo "   • max_connections: 200-400"
   echo "   • Query Cache: 256-512MB"
   echo ""
   echo "3. APPLICATION SERVER (Java/Tomcat):"
   echo "   • -Xmx: 2-3GB (50-75% vom RAM)"
   echo "   • -Xms: 1-2GB"
   echo "   • Threads: 50-100"
   echo ""
   echo "4. DOCKER/CONTAINER:"
   echo "   • Max. Container: 5-10"
   echo "   • RAM per Container: 256-512MB"
   echo "   • CPU Shares optimieren"
   echo ""
   echo "MONITORING-KOMMANDOS:"
   echo "  • CPU: mpstat -P ALL 1"
   echo "  • RAM: vmstat -s"
   echo "  • Netzwerk: sar -n DEV 1"
   echo "  • I/O: iostat -x 1"
   echo ""
   echo "Konfiguration: ${CONFIG_FILE}"
   echo "Zurücksetzen: rm ${CONFIG_FILE} && sysctl --system"
   echo "================================================================"
fi


if [ -f /etc/config/cfg/pihole ]; then
   pihole disable
   service pihole-FTL stop

   modprobe tun
   ip tuntap add dev tun0 mode tun
   ip addr add 172.29.255.2/32 dev tun0
   ifconfig tun0 up

   pihole enable
   service pihole-FTL start
   systemctl start lighttpd.service

   echo nameserver 127.0.0.1 > /etc/resolv.conf
else

   if [ -f /etc/config/cfg/stubby ]; then
      echo nameserver 127.0.0.1 > /etc/resolv.conf
      if [ -f /etc/config/cfg/nvpn ]; then
         cp /etc/resolv.conf /etc/resolv.backup > /dev/null 2>&1
      else
         if [ -f /etc/resolv.backup ]; then
            rm /etc/resolv.backup > /dev/null 2>&1
         fi
      fi
      echo .....
   else
      echo not changing dns
      echo .....
   fi
fi


if [ -f /etc/config/cfg/optimize_memory ]; then

   # Das frisst nur Memory

   systemctl stop cron.service > /dev/null 2>&1

   # Da schauen wir mal ..

   systemctl stop fail2ban.service > /dev/null 2>&1

   # Zur Fehlersuche unverzichtbar ....

   systemctl stop rsyslog.service > /dev/null 2>&1
   systemctl stop syslog.socket > /dev/null 2>&1

   systemctl stop systemd-journald > /dev/null 2>&1
   systemctl stop systemd-journald-audit.socket > /dev/null 2>&1
   systemctl stop systemd-journald-dev-log.socket > /dev/null 2>&1
   systemctl stop systemd-journald.socket > /dev/null 2>&1
   systemctl stop ufw > /dev/null 2>&1

   # kann aber auch gegen jemanden verwendet werden

   rm -rf /var/log/* > /dev/null 2>&1


else
   echo no optimize
fi

# Folgende Variablen müssen gesetzt sein damit das Feature gesetzt ist !!
# /etc/config/cfg/nvpn /etc/config/cfg/nvpn_country /etc/config/cfg/nvpn_token
# und naürlch auch das entsprechende binary selbst !!!!
#

if [ -f /etc/config/cfg/nvpn ]; then
   if [ -f /etc/config/cfg/swtor_snowflake ]; then
      echo Fehler innerhalb der aktuellen Konfiguration !!!
      echo Entweder wird nur nvpn oder nur snowflake aktiviert !
      echo Aber unter gar keinen Umständen beide Optionen !
      exit 1
   fi
fi


if [ -f /etc/config/cfg/nvpn ]; then
   echo vpn is used
fi


if [ -f /etc/config/cfg/gateway ]; then
   rm /etc/snowflake/* > /dev/null 2>&1

   # Testen ob redsocks binary exisitiert ....

   if [ -f /usr/sbin/redsocks  ]; then
      echo redsocks binary found
   else
      echo redsocks binary ist nicht installiert !
   fi

   if [ -f /etc/redsocks.conf  ]; then
      echo redsocks Konfiguration vorhanden
   else
      echo redsocks Konfiguration nicht vorhanden !
   fi

fi

if [ -f /etc/config/cfg/swtor_tor ]; then
   if [ -f /usr/sbin/tor ]; then
      using_tor="yes"
      tor_port=9050

      if [ -f /etc/config/cfg/swtor_tor_user ]; then
          tor_user=$(cat /etc/config/cfg/swtor_tor_user)
      else
          echo tor user ist nicht definiert !
          using_tor="no"
          exit 1
      fi
   else
      echo tor ist nicht installiert !
      using_tor="no"
      exit 1
   fi
else
   using_tor="no"
fi

if [ -f /etc/config/cfg/nvpn ]; then
   if [ -f /etc/config/cfg/nvpn_country ]; then
      if [ -f /etc/config/cfg/nvpn_token ]; then
         if [ -f /usr/bin/nordvpn ]; then


            rm /etc/config/vpn.sh > /dev/null 2>&1

            token=$(cat /etc/config/cfg/nvpn_token)
            country=$(cat /etc/config/cfg/nvpn_country)

            echo "#!/bin/bash" >> /etc/config/vpn.sh
            echo               >>  /etc/config/vpn.sh
            echo               >>  /etc/config/vpn.sh

            if [ -f /etc/config/cfg/disable_interface ]; then
               cat /etc/config/cfg/disable_interface  >>  /etc/config/vpn.sh
               echo               >>  /etc/config/vpn.sh
            fi

            echo /usr/bin/nordvpn login --token $token   >> /etc/config/vpn.sh

            if [ -f /etc/config/cfg/swtor_ssh_port1 ]; then
               ssh_port1=$(cat /etc/config/cfg/swtor_ssh_port1)
               echo /usr/bin/nordvpn whitelist add port $ssh_port1 >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/swtor_wireguard_port1 ]; then
                wg1=$(cat /etc/config/cfg/swtor_wireguard_port1)
                echo /usr/bin/nordvpn whitelist add port $wg1  >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/swtor_wireguard_port2 ]; then
                wg2=$(cat /etc/config/cfg/swtor_wireguard_port2)
                echo /usr/bin/nordvpn whitelist add port $wg2  >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/wireguard_subnet1 ]; then
               wg1_subnet=$(cat /etc/config/cfg/wireguard_subnet1)
               echo /usr/bin/nordvpn allowlist add subnet $wg1_subnet >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/wireguard_subnet2 ]; then
               wg2_subnet=$(cat /etc/config/cfg/wireguard_subnet2)
               echo /usr/bin/nordvpn allowlist add subnet $wg2_subnet >> /etc/config/vpn.sh
            fi

            if [ $using_tor = "yes" ] ; then
               echo /usr/bin/nordvpn allowlist add subnet 172.29.255.0/24 >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/stubby ]; then
               echo /usr/bin/nordvpn set dns 127.0.0.1  >> /etc/config/vpn.sh
            fi

            echo /usr/bin/nordvpn connect $country   >> /etc/config/vpn.sh

            echo                                     >> /etc/config/vpn.sh
            echo /usr/sbin/iptables -D OUTPUT 6      >> /etc/config/vpn.sh
            echo /usr/sbin/iptables -D OUTPUT 5      >> /etc/config/vpn.sh
            echo                                     >> /etc/config/vpn.sh
            cat /etc/config/c-part                   >> /etc/config/vpn.sh
            echo                                     >> /etc/config/vpn.sh

            if [ $using_tor = "yes" ] ; then
               echo "cd /etc/config/scripts"                          >> /etc/config/vpn.sh
               echo "killall tornode3ip.sh > /dev/null 2>&1"          >> /etc/config/vpn.sh
               echo "su" $tor_user "./tornode3ip.sh" $tor_user " > /dev/null 2>&1 &"  >> /etc/config/vpn.sh
               # echo "chown source:source /home/source/tornode3ip.log" >> /etc/config/vpn.sh
            fi

            echo                                                      >> /etc/config/vpn.sh
            chmod +x /etc/config/vpn.sh > /dev/null 2>&1

         else
             if [ -f /etc/config/vpn.sh ]; then
                rm /etc/config/vpn.sh > /dev/null 2>&1
             fi
         fi
      fi
   fi
fi


cd /etc/config
./firewall.sh > firewall.log


# Egal wie auch immer ... das VPN will er mir einfach
# auf Teufel komm raus einfach nicht starten !
# if [ -f /etc/config/cfg/nvpn ]; then
#   ./vpn.sh
# fi

systemctl start stubby.service

exit 0

