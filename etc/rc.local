#!/bin/bash
###############################################################################
# Firewall Script : rc.loclal                                                 #
# Beschreibung    : Schützen eines privaten VPS                               #
# OS              : Debian 13 trixie                                          #
###############################################################################

# By default this script does nothing.
#
# Do make it works ....
# create /etc/rc.local
# chmod +x rc.local
# systemctl daemon-reload
# systemctl start rc-local
# systemctl status rc-local


if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root"
   exit 1
fi

if [ -f /etc/config/cfg/disable_ipv6 ]; then
   /sbin/sysctl -w net.ipv6.conf.all.disable_ipv6=1 > /dev/null 2>&1
   /sbin/sysctl -w net.ipv6.conf.all.autoconf=0 > /dev/null 2>&1
   /sbin/sysctl -w net.ipv6.conf.default.disable_ipv6=1 > /dev/null 2>&1
fi

dmesg -n 1

# exit 0
#
#if [ -f /etc/rc.local2 ]; then
#   cd /etc
#   ./rc.local2
#fi

if [ -f /etc/config/cfg/optimize_virtual_server ]; then

   # Mal schauen ob es was bringt diese Werte zu setzen

   kernel.sched_autogroup_enabled = 0
   kernel.sched_migration_cost_ns = 5000000
   kernel.sched_min_granularity_ns = 1500000
   kernel.sched_wakeup_granularity_ns = 2000000

   # Welchen Nutzen haben die oben aufgeführten Änderungen ?
   # Weniger Task-Migrationen zwischen vCPUs
   # Bessere Cache-Lokalität
   # Stabilere Latenzen in VMs

   vm.swappiness = 10
   vm.vfs_cache_pressure = 50
   vm.zone_reclaim_mode = 0

   # Welchen Nutzen haben die oben aufgeführten Änderungen ?
   # Swap wird vermieden (Cloud-Storage ist langsam)
   # Dateisystem-Cache bleibt länger erhalten
   # Verhindert unnötige NUMA-Reclaims (auch bei 1 NUMA Node relevant)

   vm.dirty_background_ratio = 5
   vm.dirty_ratio = 20
   vm.dirty_expire_centisecs = 3000
   vm.dirty_writeback_centisecs = 500

   # Welchen Nutzen haben die oben aufgeführten Änderungen ?
   # Gleichmäßiger IO
   # Weniger Writeback-Spikes
   # Wichtig bei Ceph / Cinder / Netzwerkstorage

   net.core.netdev_max_backlog = 16384
   net.core.somaxconn = 4096
   net.core.rmem_max = 134217728
   net.core.wmem_max = 134217728
   net.ipv4.tcp_rmem = 4096 87380 67108864
   net.ipv4.tcp_wmem = 4096 65536 67108864
   net.ipv4.tcp_mtu_probing = 1

   # Welchen Nutzen haben die oben aufgeführten Änderungen ?
   # Bessere Burst-Verarbeitung
   # Weniger Drops bei hohem Durchsatz
   # wichtig für Load-Spitzen in VMs

   net.ipv4.tcp_fastopen = 3
   net.ipv4.tcp_tw_reuse = 1
   net.ipv4.tcp_fin_timeout = 15

   # Welchen Nutzen haben die oben aufgeführten Änderungen ?
   # Schnellere Verbindungswiederverwendung
   # Geringere Socket-Last

   echo "✔ OpenStack sysctl tuning applied"

fi


if [ -f /etc/config/cfg/pihole ]; then
   pihole disable
   service pihole-FTL stop

   modprobe tun
   ip tuntap add dev tun0 mode tun
   ip addr add 172.29.255.2/32 dev tun0
   ifconfig tun0 up

   pihole enable
   service pihole-FTL start
   systemctl start lighttpd.service

   echo nameserver 127.0.0.1 > /etc/resolv.conf
else

   if [ -f /etc/config/cfg/stubby ]; then
      echo nameserver 127.0.0.1 > /etc/resolv.conf
      if [ -f /etc/config/cfg/nvpn ]; then
         cp /etc/resolv.conf /etc/resolv.backup > /dev/null 2>&1
      else
         if [ -f /etc/resolv.backup ]; then
            rm /etc/resolv.backup > /dev/null 2>&1
         fi
      fi
      echo .....
   else
      echo not changing dns
      echo .....
   fi
fi


if [ -f /etc/config/cfg/optimize_memory ]; then

   # Das frisst nur Memory

   systemctl stop cron.service > /dev/null 2>&1

   # Da schauen wir mal ..

   systemctl stop fail2ban.service > /dev/null 2>&1

   # Zur Fehlersuche unverzichtbar ....

   systemctl stop rsyslog.service > /dev/null 2>&1
   systemctl stop syslog.socket > /dev/null 2>&1

   systemctl stop systemd-journald > /dev/null 2>&1
   systemctl stop systemd-journald-audit.socket > /dev/null 2>&1
   systemctl stop systemd-journald-dev-log.socket > /dev/null 2>&1
   systemctl stop systemd-journald.socket > /dev/null 2>&1
   systemctl stop ufw > /dev/null 2>&1

   # kann aber auch gegen jemanden verwendet werden

   rm -rf /var/log/* > /dev/null 2>&1


else
   echo no optimize
fi

# Folgende Variablen müssen gesetzt sein damit das Feature gesetzt ist !!
# /etc/config/cfg/nvpn /etc/config/cfg/nvpn_country /etc/config/cfg/nvpn_token
# und naürlch auch das entsprechende binary selbst !!!!
#

if [ -f /etc/config/cfg/nvpn ]; then
   if [ -f /etc/config/cfg/swtor_snowflake ]; then
      echo Fehler innerhalb der aktuellen Konfiguration !!!
      echo Entweder wird nur nvpn oder nur snowflake aktiviert !
      echo Aber unter gar keinen Umständen beide Optionen !
      exit 1
   fi
fi


if [ -f /etc/config/cfg/nvpn ]; then
   echo vpn is used
fi


if [ -f /etc/config/cfg/gateway ]; then
   rm /etc/snowflake/* > /dev/null 2>&1

   # Testen ob redsocks binary exisitiert ....

   if [ -f /usr/sbin/redsocks  ]; then
      echo redsocks binary found
   else
      echo redsocks binary ist nicht installiert !
   fi

   if [ -f /etc/redsocks.conf  ]; then
      echo redsocks Konfiguration vorhanden
   else
      echo redsocks Konfiguration nicht vorhanden !
   fi

fi

if [ -f /etc/config/cfg/swtor_tor ]; then
   if [ -f /usr/sbin/tor ]; then
      using_tor="yes"
      tor_port=9050

      if [ -f /etc/config/cfg/swtor_tor_user ]; then
          tor_user=$(cat /etc/config/cfg/swtor_tor_user)
      else
          echo tor user ist nicht definiert !
          using_tor="no"
          exit 1
      fi
   else
      echo tor ist nicht installiert !
      using_tor="no"
      exit 1
   fi
else
   using_tor="no"
fi

if [ -f /etc/config/cfg/nvpn ]; then
   if [ -f /etc/config/cfg/nvpn_country ]; then
      if [ -f /etc/config/cfg/nvpn_token ]; then
         if [ -f /usr/bin/nordvpn ]; then


            rm /etc/config/vpn.sh > /dev/null 2>&1

            token=$(cat /etc/config/cfg/nvpn_token)
            country=$(cat /etc/config/cfg/nvpn_country)

            echo "#!/bin/bash" >> /etc/config/vpn.sh
            echo               >>  /etc/config/vpn.sh
            echo               >>  /etc/config/vpn.sh

            if [ -f /etc/config/cfg/disable_interface ]; then
               cat /etc/config/cfg/disable_interface  >>  /etc/config/vpn.sh
               echo               >>  /etc/config/vpn.sh
            fi

            echo /usr/bin/nordvpn login --token $token   >> /etc/config/vpn.sh

            if [ -f /etc/config/cfg/swtor_ssh_port1 ]; then
               ssh_port1=$(cat /etc/config/cfg/swtor_ssh_port1)
               echo /usr/bin/nordvpn whitelist add port $ssh_port1 >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/swtor_wireguard_port1 ]; then
                wg1=$(cat /etc/config/cfg/swtor_wireguard_port1)
                echo /usr/bin/nordvpn whitelist add port $wg1  >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/swtor_wireguard_port2 ]; then
                wg2=$(cat /etc/config/cfg/swtor_wireguard_port2)
                echo /usr/bin/nordvpn whitelist add port $wg2  >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/wireguard_subnet1 ]; then
               wg1_subnet=$(cat /etc/config/cfg/wireguard_subnet1)
               echo /usr/bin/nordvpn allowlist add subnet $wg1_subnet >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/wireguard_subnet2 ]; then
               wg2_subnet=$(cat /etc/config/cfg/wireguard_subnet2)
               echo /usr/bin/nordvpn allowlist add subnet $wg2_subnet >> /etc/config/vpn.sh
            fi

            if [ $using_tor = "yes" ] ; then
               echo /usr/bin/nordvpn allowlist add subnet 172.29.255.0/24 >> /etc/config/vpn.sh
            fi

            if [ -f /etc/config/cfg/stubby ]; then
               echo /usr/bin/nordvpn set dns 127.0.0.1  >> /etc/config/vpn.sh
            fi

            echo /usr/bin/nordvpn connect $country   >> /etc/config/vpn.sh

            echo                                     >> /etc/config/vpn.sh
            echo /usr/sbin/iptables -D OUTPUT 6      >> /etc/config/vpn.sh
            echo /usr/sbin/iptables -D OUTPUT 5      >> /etc/config/vpn.sh
            echo                                     >> /etc/config/vpn.sh
            cat /etc/config/c-part                   >> /etc/config/vpn.sh
            echo                                     >> /etc/config/vpn.sh

            if [ $using_tor = "yes" ] ; then
               echo "cd /etc/config/scripts"                          >> /etc/config/vpn.sh
               echo "killall tornode3ip.sh > /dev/null 2>&1"          >> /etc/config/vpn.sh
               echo "su" $tor_user "./tornode3ip.sh" $tor_user " > /dev/null 2>&1 &"  >> /etc/config/vpn.sh
               # echo "chown source:source /home/source/tornode3ip.log" >> /etc/config/vpn.sh
            fi

            echo                                                      >> /etc/config/vpn.sh
            chmod +x /etc/config/vpn.sh > /dev/null 2>&1

         else
             if [ -f /etc/config/vpn.sh ]; then
                rm /etc/config/vpn.sh > /dev/null 2>&1
             fi
         fi
      fi
   fi
fi


cd /etc/config
./firewall.sh > firewall.log


# Egal wie auch immer ... das VPN will er mir einfach
# auf Teufel komm raus einfach nicht starten !
# if [ -f /etc/config/cfg/nvpn ]; then
#   ./vpn.sh
# fi

systemctl start stubby.service

exit 0

